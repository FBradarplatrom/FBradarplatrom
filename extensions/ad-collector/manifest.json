{
  "manifest_version": 3,
  "name": "إضافة جمع الإعلانات – رادار المنتجات الرابحة",
  "short_name": "جمع الإعلانات",
  "version": "1.2.0",
  "description": "تجمع إعلانات مكتبة ميتا وترسلها إلى منصتك. تعمل مع المنصة التي نزّلتها منها فقط، ولا تحمل مفاتيح.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://YOUR-PLATFORM-DOMAIN/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "إضافة جمع الإعلانات",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/ads/library/*",
        "https://web.facebook.com/ads/library/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.facebook.com/ads/library/*",
        "https://web.facebook.com/ads/library/*"
      ],
      "js": [
        "collector.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://YOUR-PLATFORM-DOMAIN/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    }
  ]
}
