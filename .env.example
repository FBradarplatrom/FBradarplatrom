PORT=3000
# سلسلة عشوائية طويلة (24 حرفاً على الأقل): openssl rand -hex 32
JWT_SECRET=
# من يسجّل بهذا البريد يصبح مديراً
ADMIN_EMAIL=you@example.com
# أيام تجربة مجانية للمسجّلين الجدد (0 = بدون تجربة)
TRIAL_DAYS=0
DB_FILE=data.db
NODE_ENV=production
# رابط التواصل للاشتراك يظهر في الصفحة التعريفية (واتساب مثلاً: https://wa.me/213XXXXXXXXX)
CONTACT_URL=
# عنوان المنصة الكامل (يُستعمل في روابط استعادة كلمة المرور)
APP_URL=https://winningproductradar.com
# بريد الإرسال لاستعادة كلمة المرور (من cPanel ← Email Accounts ← Connect Devices). بدونه يظهر للمستخدم رابط التواصل مع الإدارة
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="رادار المنتجات <no-reply@winningproductradar.com>"
# مجلد حفظ صور المنتجات المحفوظة (الافتراضي: بجانب قاعدة البيانات)
IMG_DIR=

# ---------- جمع الإعلانات (الإضافة) ----------
# دومين/دومينات المنصة التي تُربط بها الإضافة عند التنزيل (افتراضياً APP_URL + العنوان الذي يفتح منه المشترك). افصل بفاصلة
BRIDGE_ORIGINS=
# الدفعات المجمَّعة التي لم تُحلَّل تُحذف بعد هذه المدة (أيام). ما حُلِّل يبقى في الأرشيف
LIB_RETENTION_DAYS=45
# أقصى إعلانات في الدفعة الواحدة داخل «الواردة»
LIB_MAX_ADS_PER_BATCH=15000
# حدود الجمع لحماية حساب المستخدم على فيسبوك
LIB_MAX_SEARCHES_PER_BATCH=15
LIB_MAX_SEARCHES_PER_DAY=60
LIB_MAX_ADS_PER_SEARCH=3000
# السماح بالسرعة «السريعة» (غير مستحسن)
LIB_ALLOW_FAST=0
# أدنى إصدار للإضافة مقبول (يُمنع الجمع بإصدار أقدم)
LIB_BRIDGE_MIN_VERSION=

# ---------- 11.0: الدفع والتنبيهات (الأفضل ضبطها من «الربط والتكامل» داخل المنصة؛ هذه بدائل فقط) ----------
# OPENAI_API_KEY=
# CIB / الذهبية مباشرة عبر SATIM (عقد مع البنك):
# SATIM_USER=
# SATIM_PASSWORD=
# SATIM_TERMINAL_ID=
# SATIM_MODE=test             # test أو live
# Stripe (بطاقات دولية):
# STRIPE_SECRET_KEY=          # sk_test_… أو sk_live_…
# STRIPE_WEBHOOK_SECRET=      # whsec_…
# PayPal:
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# PAYPAL_MODE=test            # test أو live
# BARIDI_INFO=                # RIP/CCP والاسم كما يراه المشترك
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# APP_URL=https://winningproductradar.com
# قياس الزيارات في الصفحات العامة فقط (أو من «الربط والتكامل»):
# GA_ID=G-XXXXXXXXXX
# META_PIXEL_ID=123456789012345
# معلومات الدعم (تظهر في «المساعدة والدعم» والصفحات القانونية):
# SUPPORT_EMAIL=support@winningproductradar.com
# SUPPORT_WHATSAPP=+213XXXXXXXXX
# بريد الإرسال: MAIL_FROM أو SMTP_FROM (مثلاً: winningproductradar <contact@winningproductradar.com>)
# MAIL_FROM=
# إن ظهر خطأ شهادة (altnames/certificate) في «إرسال بريد تجريبي»: اسم خادم البريد من cPanel ← Email Accounts ← Connect Devices
# SMTP_TLS_SERVERNAME=
# حل أخير فقط: SMTP_TLS_INSECURE=1
